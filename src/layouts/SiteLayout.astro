---
// Estrutura comum a todas as páginas: cabeçalho, conteúdo, rodapé e a marcIA.
import BaseLayout from './BaseLayout.astro';
import type { Schema } from '../lib/schema';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ChatWidget from '../components/ChatWidget.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  schema?: Schema[];
}

const { title, description, noindex, schema } = Astro.props;
---

<BaseLayout title={title} description={description} noindex={noindex} schema={schema}>
  <SiteHeader />
  <main id="conteudo" tabindex="-1">
    <slot />
  </main>
  <SiteFooter />
  <ChatWidget />
</BaseLayout>
