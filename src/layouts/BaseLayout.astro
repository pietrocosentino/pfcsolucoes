---
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';
import '@fontsource/inter/latin-800.css';
import '../styles/global.css';
import { about, brand, contact } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title = brand.seoTitle, description = brand.description, noindex = false } = Astro.props;

// Endereços absolutos: o WhatsApp e o Instagram só mostram a prévia com URL completa.
// Sem barra no fim, igual aos links internos (/sobre).
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = new URL(path, Astro.site);
const ogImage = new URL('/og-image.png', Astro.site);

// Dados estruturados: ajudam o Google a entender quem é a empresa e o que ela faz.
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': new URL('/#empresa', Astro.site).href,
      name: brand.fullName,
      alternateName: brand.name,
      url: Astro.site!.href,
      logo: new URL('/apple-touch-icon.png', Astro.site).href,
      description: brand.description,
      email: contact.email,
      taxID: brand.cnpj,
      areaServed: { '@type': 'Country', name: 'Brasil' },
      founder: { '@type': 'Person', name: about.name, url: about.portfolio.href },
      sameAs: [contact.instagramProfile],
      knowsAbout: ['Agente de IA no WhatsApp', 'Agendamento online', 'Controle financeiro', 'Sites profissionais', 'Sistemas sob medida'],
    },
    {
      '@type': 'WebSite',
      '@id': new URL('/#site', Astro.site).href,
      name: brand.name,
      url: Astro.site!.href,
      inLanguage: 'pt-BR',
      publisher: { '@id': new URL('/#empresa', Astro.site).href },
    },
  ],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#E4EBE2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111827" media="(prefers-color-scheme: dark)" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`Logo da ${brand.fullName}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <slot />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: 16px;
    top: -100px;
    z-index: 100;
    padding: 12px 18px;
    border-radius: var(--radius-sm);
    background: var(--brand-navy);
    color: #ffffff;
    font-weight: 700;
    text-decoration: none;
  }
  .skip-link:focus {
    top: 12px;
  }
</style>
