---
import Section from './Section.astro';
import Button from './Button.astro';
import { contact, contactSection } from '../data/site';
---

<Section id="contato" tone="dark" align="center" title={contactSection.title} lead={contactSection.lead}>
  <div class="cta">
    <Button href={contact.whatsapp} variant="inverse" external chat>{contact.ctaLabel}</Button>
    <p class="email">
      Prefere falar com uma pessoa? <a href={contact.schedule} target="_blank" rel="noopener noreferrer">Agende uma conversa de 1 hora<span class="visually-hidden"> (abre em nova aba)</span></a>
    </p>
    <p class="email">Ou escreva para <a href={`mailto:${contact.email}`}>{contact.email}</a></p>
  </div>
</Section>

<style>
  .cta {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    margin-top: calc(-1 * var(--space-6));
  }
  .email {
    margin: 0;
    color: var(--dark-muted);
  }
  .email a {
    color: var(--dark-text);
    font-weight: var(--weight-semibold);
    overflow-wrap: anywhere;
  }
</style>
