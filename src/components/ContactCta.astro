---
import Section from './Section.astro';
import Button from './Button.astro';
import { contact, contactSection } from '../data/site';
---

<Section id="contato" tone="dark" align="center" title={contactSection.title} lead={contactSection.lead}>
  <div class="cta">
    {/* [PREENCHER: foto do Pietro, quando houver uma aprovada] */}
    <div class="actions">
      <Button href={contact.schedule} variant="inverse" external>{contact.scheduleLabel}</Button>
      <Button href={contact.whatsapp} variant="inverse-outline" external chat>{contact.ctaLabel}</Button>
    </div>
    <p class="email">E-mail: <a href={`mailto:${contact.email}`}>{contact.email}</a></p>
  </div>
</Section>

<style>
  .cta {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    margin-top: calc(-1 * var(--space-6));
  }
  .actions {
    justify-content: center;
  }
  .email {
    margin: 0;
    color: var(--dark-muted);
  }
  .email a {
    color: var(--dark-text);
    font-weight: var(--weight-semibold);
    overflow-wrap: anywhere;
  }
</style>
