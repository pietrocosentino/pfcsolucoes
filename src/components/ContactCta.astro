---
import Section from './Section.astro';
import Button from './Button.astro';
import { contact, contactSection } from '../data/site';
---

<Section id="contato" tone="dark" align="center" eyebrow={contactSection.eyebrow} title={contactSection.title} lead={contactSection.lead}>
  <div class="cta">
    <Button href={contact.whatsapp} variant="inverse" external chat>{contact.ctaLabel}</Button>
  </div>
</Section>

<style>
  .cta {
    display: grid;
    justify-items: center;
    gap: 16px;
    margin-top: -12px;
  }
</style>
