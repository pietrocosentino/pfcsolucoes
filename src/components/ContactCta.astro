---
import Section from './Section.astro';
import Button from './Button.astro';
import { contact, contactSection } from '../data/site';
---

<Section id="contato" tone="dark" align="center" eyebrow={contactSection.eyebrow} title={contactSection.title} lead={contactSection.lead}>
  <div class="cta">
    <Button href={contact.whatsapp} variant="inverse" external chat>{contact.ctaLabel}</Button>
    <p class="email">Prefere e-mail? <a href={`mailto:${contact.email}`}>{contact.email}</a></p>
  </div>
</Section>

<style>
  .cta {
    display: grid;
    justify-items: center;
    gap: 16px;
    margin-top: -12px;
  }
  .email {
    margin: 0;
    color: var(--color-dark-muted);
  }
  .email a {
    color: var(--color-dark-text);
    font-weight: 600;
    overflow-wrap: anywhere;
  }
</style>
