---
// Primeira dobra: o que é, para quem e o produto funcionando (print real da marcIA).
import { Image } from 'astro:assets';
import Button from './Button.astro';
import { contact, hero } from '../data/site';
import shot from '../assets/prints/marcia-conversa.png';
---

<section id="inicio" class="hero" aria-labelledby="inicio-titulo">
  <div class="wrap grid">
    <div class="copy">
      <h1 id="inicio-titulo">
        {hero.title} <span class="highlight">{hero.highlight}</span>
      </h1>
      <p class="lead">{hero.lead}</p>
      <div class="actions">
        <Button href={contact.whatsapp} external chat>{hero.primaryCta}</Button>
        <Button href={hero.secondaryCta.href} variant="secondary">{hero.secondaryCta.label}</Button>
      </div>
      <p class="note">{hero.note}</p>
    </div>

    <figure class="shot">
      <div class="phone">
        <Image
          src={shot}
          alt="Conversa no chat: a marcIA pergunta o que dá trabalho no negócio, o visitante conta que perde clientes no WhatsApp porque não consegue responder enquanto corta cabelo, e ela pergunta o que acontece com essas mensagens depois"
          widths={[300, 600]}
          sizes="300px"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <figcaption>{hero.shotCaption}</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    background: var(--color-band);
    padding-block: clamp(40px, 7vw, 88px);
  }
  .grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }
  .copy {
    display: grid;
    gap: 18px;
  }
  h1 {
    font-size: clamp(2.125rem, 5vw, 3.375rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.06;
  }
  /* A sobrancelha faz parte do h1 (diz ao Google o que a empresa faz), com o visual de sempre. */
  h1 .eyebrow {
    display: block;
    margin-bottom: 16px;
    line-height: 1.4;
  }
  .highlight {
    display: block;
    color: var(--color-accent-text);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 6px;
  }
  .note {
    font-size: 0.875rem;
    color: var(--color-muted);
    max-width: 52ch;
  }

  .shot {
    display: grid;
    justify-items: center;
    gap: 12px;
    margin: 0;
  }
  .phone {
    width: min(300px, 80vw);
    padding: 8px;
    border-radius: 34px;
    background: var(--brand-navy);
    box-shadow: 0 30px 60px -30px rgb(27 42 74 / 0.6);
  }
  .phone :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 26px;
  }
  .shot figcaption {
    max-width: 300px;
    font-size: 0.8125rem;
    text-align: center;
    color: var(--color-muted);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 420px) {
    .actions :global(.btn) {
      width: 100%;
    }
  }
</style>
