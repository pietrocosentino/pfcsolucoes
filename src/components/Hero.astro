---
// Primeira dobra: problema, resultado e próximo passo. O visual usa antes,
// depois e ponte: a dor na voz do cliente, o resultado e o que a PFC entrega.
import Button from './Button.astro';
import { contact, hero } from '../data/site';

const { transformation } = hero;
---

<section id="inicio" class="hero" aria-labelledby="inicio-titulo">
  <div class="wrap grid">
    <div class="copy">
      <h1 id="inicio-titulo">
        <span class="eyebrow">{hero.eyebrow}</span>
        {hero.title} <span class="highlight">{hero.highlight}</span>
      </h1>
      <p class="lead">{hero.lead}</p>
      <div class="actions">
        <Button href={contact.whatsapp} external chat>{hero.primaryCta}</Button>
        <Button href={hero.secondaryCta.href} variant="secondary">{hero.secondaryCta.label}</Button>
      </div>
      <p class="note">{hero.note}</p>
    </div>

    <figure class="change">
      <figcaption>
        <span class="title">{transformation.title}</span>
        <span class="subtitle">{transformation.subtitle}</span>
      </figcaption>
      <ul>
        {transformation.items.map((item) => (
          <li>
            <p class="pain"><span class="label">Hoje</span> {item.pain}</p>
            <p class="gain"><span class="label">Com a PFC</span> {item.gain}</p>
            <p class="solution">{item.solution}</p>
          </li>
        ))}
      </ul>
    </figure>
  </div>
</section>

<style>
  .hero {
    background: var(--color-band);
    padding-block: clamp(40px, 7vw, 88px);
  }
  .grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }
  .copy {
    display: grid;
    gap: 18px;
  }
  h1 {
    font-size: clamp(2.125rem, 5vw, 3.375rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.06;
  }
  /* A sobrancelha faz parte do h1 (diz ao Google o que a empresa faz), com o visual de sempre. */
  h1 .eyebrow {
    display: block;
    margin-bottom: 16px;
    line-height: 1.4;
  }
  .highlight {
    display: block;
    color: var(--color-accent-text);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 6px;
  }
  .note {
    font-size: 0.875rem;
    color: var(--color-muted);
    max-width: 52ch;
  }

  .change {
    margin: 0;
    padding: 24px;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    box-shadow: 0 24px 48px -24px rgb(27 42 74 / 0.35);
  }
  figcaption {
    display: grid;
    gap: 2px;
    margin-bottom: 6px;
  }
  .title {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-ink);
  }
  .subtitle {
    font-size: 0.875rem;
    color: var(--color-muted);
  }
  .change ul {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .change li {
    display: grid;
    gap: 6px;
    padding: 14px 0;
    border-top: 1px solid var(--color-line);
  }
  .change li:first-child {
    border-top: 0;
  }
  .pain {
    font-size: 0.9375rem;
    line-height: 1.4;
    color: var(--color-muted);
  }
  .pain .label {
    margin-right: 4px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink);
  }
  .gain {
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.4;
    color: var(--color-ink);
  }
  .gain .label {
    margin-right: 4px;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent-text);
  }
  .solution {
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 420px) {
    .actions :global(.btn) {
      width: 100%;
    }
    .change {
      padding: 18px;
    }
  }
</style>
