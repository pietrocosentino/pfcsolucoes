---
// Primeira dobra: o que é, para quem e o produto funcionando (print real da marcIA).
import { Image } from 'astro:assets';
import Button from './Button.astro';
import { contact, hero } from '../data/site';
import shot from '../assets/prints/marcia-conversa.png';
---

<section id="inicio" class="hero" aria-labelledby="inicio-titulo">
  <div class="wrap grid">
    <div class="copy">
      <h1 id="inicio-titulo">
        <span class="label-caps kicker">{hero.kicker}</span>
        {hero.title}
      </h1>
      <p class="lead">{hero.lead}</p>
      <div class="actions">
        <Button href={contact.schedule} external>{contact.scheduleLabel}</Button>
        <Button href={contact.whatsapp} variant="secondary" external chat>{hero.primaryCta}</Button>
      </div>
    </div>

    <figure class="shot">
      <div class="screen">
        <Image
          src={shot}
          alt="Conversa no chat: a marcIA pergunta o que dá trabalho no negócio, o visitante conta que perde clientes no WhatsApp porque não consegue responder enquanto corta cabelo, e ela pergunta quantos clientes deixam de marcar assim por semana"
          widths={[340, 680]}
          sizes="340px"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <figcaption>{hero.shotCaption}</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    background: var(--color-subtle);
    padding-block: clamp(var(--space-12), 7vw, var(--space-24));
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr var(--device-width);
    gap: clamp(var(--space-8), 5vw, var(--space-16));
    align-items: center;
  }
  .copy {
    display: grid;
    gap: var(--space-4);
  }
  .kicker {
    display: block;
    margin-bottom: var(--space-4);
    color: var(--color-accent);
  }
  .actions {
    align-items: center;
    margin-top: var(--space-2);
  }

  .shot {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    margin: 0;
  }
  /* Captura de tela simples, sem moldura de aparelho. */
  .screen {
    width: min(var(--device-width), 80vw);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-overlay);
  }
  .screen :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .shot figcaption {
    max-width: var(--device-width);
    font-size: var(--text-sm);
    text-align: center;
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .actions :global(.btn) {
      width: 100%;
      padding-inline: var(--space-4);
    }
  }
</style>
