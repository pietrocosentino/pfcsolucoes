---
// Primeira dobra: problema, resultado e próximo passo. O visual mostra a
// transformação (hoje × com a PFC) em vez de uma tela de produto.
import Button from './Button.astro';
import { contact, hero } from '../data/site';

const { transformation } = hero;
---

<section id="inicio" class="hero" aria-labelledby="inicio-titulo">
  <div class="wrap grid">
    <div class="copy">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1 id="inicio-titulo">
        {hero.title} <span class="highlight">{hero.highlight}</span>
      </h1>
      <p class="lead">{hero.lead}</p>
      <div class="actions">
        <Button href={contact.whatsapp} external chat>{hero.primaryCta}</Button>
        <Button href={hero.secondaryCta.href} variant="secondary">{hero.secondaryCta.label}</Button>
      </div>
      <p class="note">{hero.note}</p>
      <ul class="proof">
        {hero.proof.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <figure class="change">
      <figcaption>{transformation.title}</figcaption>
      <div class="labels" aria-hidden="true">
        <span>{transformation.beforeLabel}</span>
        <span>{transformation.afterLabel}</span>
      </div>
      <ul>
        {transformation.items.map((item) => (
          <li>
            <span class="before">
              <span class="visually-hidden">{transformation.beforeLabel}: </span>{item.before}
            </span>
            <svg class="arrow" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
              <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span class="after">
              <span class="visually-hidden">{transformation.afterLabel}: </span>{item.after}
            </span>
          </li>
        ))}
      </ul>
    </figure>
  </div>
</section>

<style>
  .hero {
    background: var(--color-band);
    padding-block: clamp(40px, 7vw, 88px);
  }
  .grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }
  .copy {
    display: grid;
    gap: 18px;
  }
  h1 {
    font-size: clamp(2.125rem, 5vw, 3.375rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.06;
  }
  .highlight {
    display: block;
    color: var(--color-accent-text);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 6px;
  }
  .note {
    font-size: 0.875rem;
    color: var(--color-muted);
    max-width: 52ch;
  }
  .proof {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
  }
  .proof li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .proof li::before {
    content: '';
    width: 8px;
    height: 5px;
    border-left: 2px solid var(--color-accent-text);
    border-bottom: 2px solid var(--color-accent-text);
    transform: rotate(-45deg) translateY(-1px);
  }

  .change {
    margin: 0;
    padding: 24px;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    box-shadow: 0 24px 48px -24px rgb(27 42 74 / 0.35);
  }
  figcaption {
    margin-bottom: 14px;
    font-size: 1.125rem;
    font-weight: 800;
    color: var(--color-ink);
  }
  .labels {
    display: grid;
    grid-template-columns: 1fr 18px 1fr;
    gap: 10px;
    margin-bottom: 8px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .labels span:last-child {
    grid-column: 3;
    color: var(--color-accent-text);
  }
  .change ul {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .change li {
    display: grid;
    grid-template-columns: 1fr 18px 1fr;
    align-items: center;
    gap: 10px;
    padding: 10px 0;
    border-top: 1px solid var(--color-line);
    font-size: 0.9375rem;
    line-height: 1.35;
  }
  .before {
    color: var(--color-muted);
    text-decoration: line-through;
    text-decoration-color: color-mix(in srgb, var(--color-muted) 60%, transparent);
  }
  .arrow {
    color: var(--color-accent-text);
  }
  .after {
    font-weight: 700;
    color: var(--color-ink);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 420px) {
    .actions :global(.btn) {
      width: 100%;
    }
    .change {
      padding: 18px;
    }
    .change li {
      font-size: 0.875rem;
    }
  }
</style>
