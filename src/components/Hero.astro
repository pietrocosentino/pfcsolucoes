---
// Primeira dobra: o que é, para quem e o produto funcionando (print real da marcIA).
import { Image } from 'astro:assets';
import Button from './Button.astro';
import { contact, hero } from '../data/site';
import shot from '../assets/prints/marcia-conversa.png';
---

<section id="inicio" class="hero" aria-labelledby="inicio-titulo">
  <div class="wrap grid">
    <div class="copy">
      <h1 id="inicio-titulo">
        {hero.title}
      </h1>
      <p class="lead">{hero.lead}</p>
      <div class="actions">
        <Button href={contact.whatsapp} external chat>{hero.primaryCta}</Button>
        <Button href={hero.secondaryCta.href} variant="secondary">{hero.secondaryCta.label}</Button>
      </div>
      <p class="note">{hero.note}</p>
    </div>

    <figure class="shot">
      <div class="phone">
        <Image
          src={shot}
          alt="Conversa no chat: a marcIA pergunta o que dá trabalho no negócio, o visitante conta que perde clientes no WhatsApp porque não consegue responder enquanto corta cabelo, e ela pergunta o que acontece com essas mensagens depois"
          widths={[300, 600]}
          sizes="300px"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <figcaption>{hero.shotCaption}</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    background: var(--color-subtle);
    padding-block: clamp(var(--space-12), 7vw, var(--space-24));
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr var(--device-width);
    gap: clamp(var(--space-8), 5vw, var(--space-16));
    align-items: center;
  }
  .copy {
    display: grid;
    gap: var(--space-4);
  }
  .actions {
    margin-top: var(--space-2);
  }
  .note {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    max-width: var(--measure-short);
  }

  .shot {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    margin: 0;
  }
  .phone {
    width: min(var(--device-width), 80vw);
    padding: var(--space-2);
    border-radius: var(--radius-device);
    background: var(--dark-bg);
    box-shadow: var(--shadow-overlay);
  }
  .phone :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-device-screen);
  }
  .shot figcaption {
    max-width: var(--device-width);
    font-size: var(--text-sm);
    text-align: center;
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .actions :global(.btn) {
      width: 100%;
      padding-inline: var(--space-4);
    }
  }
</style>
