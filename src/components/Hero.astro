---
import Button from './Button.astro';
import ChatMock from './ChatMock.astro';
import { contact, hero } from '../data/site';
---

<section id="inicio" class="hero" aria-labelledby="inicio-titulo">
  <div class="wrap grid">
    <div class="copy">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1 id="inicio-titulo">
        {hero.title} <span class="highlight">{hero.highlight}</span>
      </h1>
      <p class="lead">{hero.lead}</p>
      <div class="actions">
        <Button href={contact.instagramDirect} external>{contact.ctaLabel}</Button>
        <Button href="#solucoes" variant="secondary">Ver soluções</Button>
      </div>
      <p class="note">{hero.note}</p>
    </div>
    <ChatMock />
  </div>
</section>

<style>
  .hero {
    background: var(--color-band);
    padding-block: clamp(40px, 7vw, 88px);
  }
  .grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }
  .copy {
    display: grid;
    gap: 18px;
  }
  h1 {
    font-size: clamp(2.125rem, 5.4vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.06;
  }
  .highlight {
    color: var(--color-accent-text);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 6px;
  }
  .note {
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 420px) {
    .actions :global(.btn) {
      width: 100%;
    }
  }
</style>
