---
// Primeira dobra: problema, resultado e próximo passo. O visual usa antes,
// depois e ponte: a dor na voz do cliente, o resultado e o que a PFC entrega.
import Button from './Button.astro';
import { contact, hero } from '../data/site';

const { transformation } = hero;
---

<section id="inicio" class="hero" aria-labelledby="inicio-titulo">
  <div class="wrap grid">
    <div class="copy">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1 id="inicio-titulo">
        {hero.title} <span class="highlight">{hero.highlight}</span>
      </h1>
      <p class="lead">{hero.lead}</p>
      <div class="actions">
        <Button href={contact.whatsapp} external chat>{hero.primaryCta}</Button>
        <Button href={hero.secondaryCta.href} variant="secondary">{hero.secondaryCta.label}</Button>
      </div>
      <p class="note">{hero.note}</p>
      <ul class="proof">
        {hero.proof.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <figure class="change">
      <figcaption>
        <span class="title">{transformation.title}</span>
        <span class="subtitle">{transformation.subtitle}</span>
      </figcaption>
      <ul>
        {transformation.items.map((item) => (
          <li>
            <p class="pain"><span class="visually-hidden">Hoje: </span>“{item.pain}”</p>
            <p class="gain">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                <path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span><span class="visually-hidden">Com a PFC: </span>{item.gain}</span>
            </p>
            <p class="solution"><span class="visually-hidden">Solução: </span>{item.solution}</p>
          </li>
        ))}
      </ul>
    </figure>
  </div>
</section>

<style>
  .hero {
    background: var(--color-band);
    padding-block: clamp(40px, 7vw, 88px);
  }
  .grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }
  .copy {
    display: grid;
    gap: 18px;
  }
  h1 {
    font-size: clamp(2.125rem, 5vw, 3.375rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.06;
  }
  .highlight {
    display: block;
    color: var(--color-accent-text);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 6px;
  }
  .note {
    font-size: 0.875rem;
    color: var(--color-muted);
    max-width: 52ch;
  }
  .proof {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
  }
  .proof li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .proof li::before {
    content: '';
    width: 8px;
    height: 5px;
    border-left: 2px solid var(--color-accent-text);
    border-bottom: 2px solid var(--color-accent-text);
    transform: rotate(-45deg) translateY(-1px);
  }

  .change {
    margin: 0;
    padding: 24px;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    box-shadow: 0 24px 48px -24px rgb(27 42 74 / 0.35);
  }
  figcaption {
    display: grid;
    gap: 2px;
    margin-bottom: 6px;
  }
  .title {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-ink);
  }
  .subtitle {
    font-size: 0.875rem;
    color: var(--color-muted);
  }
  .change ul {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .change li {
    display: grid;
    gap: 6px;
    padding: 14px 0;
    border-top: 1px solid var(--color-line);
  }
  .change li:first-child {
    border-top: 0;
  }
  .pain {
    font-size: 0.9375rem;
    font-style: italic;
    line-height: 1.4;
    color: var(--color-muted);
  }
  .gain {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.4;
    color: var(--color-ink);
  }
  .gain svg {
    flex: none;
    margin-top: 2px;
    color: var(--color-accent-text);
  }
  .solution {
    justify-self: start;
    margin-left: 26px;
    padding: 2px 10px;
    border-radius: var(--radius-pill);
    background: var(--color-chip);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-ink);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 420px) {
    .actions :global(.btn) {
      width: 100%;
    }
    .change {
      padding: 18px;
    }
  }
</style>
