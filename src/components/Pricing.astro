---
// Como cobramos e prazo, em tabela. Sem valores: o valor fechado sai na proposta.
import Section from './Section.astro';
import { pricing } from '../data/site';
---

<Section id="precos" tone="band" title={pricing.title} lead={pricing.lead}>
  <div class="card table-wrap">
    <table>
      <caption class="visually-hidden">Como cada serviço é cobrado e o prazo</caption>
      <thead>
        <tr>
          <td></td>
          <th scope="col">{pricing.columns[0]}</th>
          <th scope="col">{pricing.columns[1]}</th>
        </tr>
      </thead>
      <tbody>
        {pricing.rows.map((row) => (
          <tr>
            <th scope="row">{row.label}</th>
            <td data-label={pricing.columns[0]}>{row.price}</td>
            <td data-label={pricing.columns[1]}>{row.time}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="more"><a class="link-arrow" href={pricing.link.href}>{pricing.link.label}</a></p>
</Section>

<style>
  .table-wrap {
    overflow: hidden;
  }
  table {
    width: 100%;
    border-collapse: collapse;
  }
  th,
  td {
    padding: var(--space-3) var(--space-4);
    text-align: left;
    vertical-align: top;
    border-top: 1px solid var(--color-border);
  }
  thead th,
  thead td {
    border-top: 0;
    font-weight: var(--weight-bold);
    color: var(--color-heading);
  }
  tbody th {
    width: 32%;
    font-weight: var(--weight-bold);
    color: var(--color-heading);
  }
  td {
    color: var(--color-text);
  }
  .more {
    margin-top: var(--space-4);
  }
  /* No celular, cada linha vira um bloco com o nome da coluna antes do texto. */
  @media (max-width: 560px) {
    thead {
      display: none;
    }
    tr,
    tbody th,
    td {
      display: block;
      width: auto;
    }
    tbody tr + tr {
      border-top: 1px solid var(--color-border);
    }
    tbody th {
      border-top: 0;
      padding-bottom: var(--space-1);
    }
    td {
      border-top: 0;
      padding-top: var(--space-1);
    }
    td::before {
      content: attr(data-label) ': ';
      font-weight: var(--weight-bold);
      color: var(--color-heading);
    }
  }
</style>
