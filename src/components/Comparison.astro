---
// Ajuda quem pesquisa "sistema sob medida" a decidir contra um aplicativo pronto.
// Em tabela: fácil de comparar para quem lê e de extrair para buscadores e IAs.
import Section from './Section.astro';
import { comparison } from '../data/site';
---

<Section id="sob-medida-ou-pronto" tone="band" title={comparison.title}>
  <div class="card table-wrap">
    <table>
      <caption class="visually-hidden">Comparação entre aplicativo pronto e sistema sob medida</caption>
      <thead>
        <tr>
          <td></td>
          <th scope="col">{comparison.columns[0]}</th>
          <th scope="col" class="custom">{comparison.columns[1]}</th>
        </tr>
      </thead>
      <tbody>
        {comparison.rows.map((row) => (
          <tr>
            <th scope="row">{row.label}</th>
            <td data-label="Pronto">{row.ready}</td>
            <td data-label="Sob medida" class="custom">{row.custom}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Section>

<style>
  .table-wrap {
    overflow: hidden;
  }
  table {
    width: 100%;
    border-collapse: collapse;
  }
  th,
  td {
    padding: var(--space-3) var(--space-4);
    text-align: left;
    vertical-align: top;
    border-top: 1px solid var(--color-border);
  }
  thead th,
  thead td {
    border-top: 0;
    font-size: var(--text-md);
    font-weight: var(--weight-bold);
    color: var(--color-heading);
  }
  tbody th {
    width: 22%;
    font-weight: var(--weight-bold);
    color: var(--color-heading);
  }
  td {
    color: var(--color-text-muted);
  }
  /* No celular, cada linha vira um bloco com o nome da coluna antes do texto. */
  @media (max-width: 560px) {
    thead {
      display: none;
    }
    tr,
    tbody th,
    td {
      display: block;
      width: auto;
    }
    tbody tr + tr {
      border-top: 1px solid var(--color-border);
    }
    tbody th {
      border-top: 0;
      padding-bottom: var(--space-1);
    }
    td {
      border-top: 0;
      padding-top: var(--space-2);
    }
    td::before {
      content: attr(data-label) ': ';
      font-weight: var(--weight-bold);
      color: var(--color-heading);
    }
  }
</style>
