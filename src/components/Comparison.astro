---
// Ajuda quem pesquisa "sistema sob medida" a decidir contra um aplicativo pronto.
import Section from './Section.astro';
import { comparison } from '../data/site';
---

<Section id="sob-medida-ou-pronto" eyebrow={comparison.eyebrow} title={comparison.title}>
  <div class="options">
    {comparison.options.map((option, index) => (
      <article class:list={['option', { highlight: index === 1 }]}>
        <h3>{option.name}</h3>
        <p>{option.text}</p>
      </article>
    ))}
  </div>
  <p class="closing">{comparison.closing}</p>
  <p class="next"><a href={comparison.more.href}>{comparison.more.label}</a></p>
</Section>

<style>
  .options {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }
  @media (max-width: 700px) {
    .options {
      grid-template-columns: 1fr;
    }
  }
  .option {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 26px;
    border-radius: var(--radius-md);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
  }
  .option p {
    color: var(--color-muted);
  }
  .highlight {
    border-color: var(--color-accent-text);
    box-shadow: inset 0 3px 0 var(--color-accent-text);
  }
  h3 {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-ink);
  }
  .closing {
    margin-top: 24px;
    max-width: 62ch;
    color: var(--color-text);
  }
  .next {
    margin-top: 8px;
  }
  .next a {
    font-weight: 700;
    color: var(--color-accent-text);
  }
</style>
