---
import Section from './Section.astro';
import { contact, faq } from '../data/site';
---

<Section id="duvidas" title={faq.title} split>
  <p slot="head" class="help">
    Não achou sua dúvida? <a href={contact.whatsapp} data-chat-open aria-haspopup="dialog">Fale com a gente</a>.
  </p>
  <div class="faq">
    {faq.items.map((item) => (
      <details class="card">
        <summary><h3>{item.question}</h3></summary>
        <p>{item.answer}</p>
        {item.link && <p><a href={item.link.href}>{item.link.label}</a></p>}
      </details>
    ))}
  </div>
</Section>

<style>
  .faq {
    display: grid;
    gap: var(--space-3);
    max-width: var(--width-narrow);
  }
  .help {
    color: var(--color-text-muted);
  }
  .help a {
    font-weight: var(--weight-bold);
  }
  summary {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--control-md);
    padding: var(--space-3) var(--space-6);
    cursor: pointer;
    list-style: none;
    font-weight: var(--weight-bold);
    color: var(--color-heading);
  }
  summary h3 {
    font-size: inherit;
    font-weight: inherit;
    line-height: var(--leading-snug);
    margin: 0;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  /* O sinal fica junto da pergunta, dentro da área clicável. */
  summary::before {
    content: '+';
    flex: none;
    width: 1ch;
    font-size: var(--text-xl);
    line-height: 1;
    color: var(--color-accent);
  }
  details[open] summary::before {
    content: '−';
  }
  details p {
    max-width: var(--measure);
    padding: 0 var(--space-6) var(--space-4) calc(var(--space-6) + 1ch + var(--space-3));
    color: var(--color-text-muted);
  }
</style>
