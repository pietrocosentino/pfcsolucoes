---
import Section from './Section.astro';
import { about, contact, faq } from '../data/site';
---

<Section id="duvidas" tone="band" title={faq.title} split>
  <div slot="head" class="help">
    <p>Não achou sua dúvida? Pergunte para quem constrói.</p>
    <div class="person">
      {/* [PREENCHER: foto pequena do Pietro, quando houver uma aprovada] */}
      <p class="name">{about.name}<span>Fundador da PFC</span></p>
      <a class="link-arrow" href={`mailto:${contact.email}`}>Perguntar direto</a>
    </div>
  </div>
  <div class="faq">
    {faq.items.map((item) => (
      <details class="card">
        <summary><h3>{item.question}</h3></summary>
        <p>{item.answer}</p>
        {item.link && <p><a class="link-arrow" href={item.link.href}>{item.link.label}</a></p>}
      </details>
    ))}
  </div>
</Section>

<style>
  .faq {
    display: grid;
    gap: var(--space-3);
    max-width: var(--width-narrow);
  }
  .help {
    display: grid;
    gap: var(--space-4);
    color: var(--color-text-muted);
  }
  .person {
    display: grid;
    gap: var(--space-1);
    justify-items: start;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }
  .name {
    display: grid;
    font-weight: var(--weight-semibold);
    color: var(--color-heading);
  }
  .name span {
    font-size: var(--text-sm);
    font-weight: var(--weight-regular);
    color: var(--color-text-muted);
  }
  summary {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--control-md);
    padding: var(--space-3) var(--space-6);
    cursor: pointer;
    list-style: none;
    font-weight: var(--weight-bold);
    color: var(--color-heading);
  }
  summary h3 {
    font-size: inherit;
    font-weight: inherit;
    line-height: var(--leading-snug);
    margin: 0;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  /* O sinal fica junto da pergunta, dentro da área clicável. */
  summary::before {
    content: '+';
    flex: none;
    width: 1ch;
    font-size: var(--text-xl);
    line-height: 1;
    color: var(--color-accent);
  }
  details[open] summary::before {
    content: '−';
  }
  details p {
    max-width: var(--measure);
    padding: 0 var(--space-6) var(--space-4) calc(var(--space-6) + 1ch + var(--space-3));
    color: var(--color-text-muted);
  }
</style>
