---
import Logo from './Logo.astro';
import SocialLinks from './SocialLinks.astro';
import { assistant, brand, contact, footer } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap grid">
    <div class="about">
      <a class="brand" href="/" aria-label={`${brand.fullName}, página inicial`}>
        <Logo size={34} />
        <span>{brand.fullName}</span>
      </a>
      <p>{footer.summary}</p>
      <SocialLinks class="social" />
    </div>

    {footer.columns.map((column) => (
      <nav class="column" aria-label={column.title}>
        <h2>{column.title}</h2>
        <ul>
          {column.links.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </nav>
    ))}

    <div class="column">
      <h2>Contato</h2>
      <ul>
        <li>
          <a href="/#contato" data-chat-open aria-haspopup="dialog">
            Fale com a {assistant.name}
          </a>
        </li>
        <li>
          <a href={contact.instagramProfile} target="_blank" rel="noopener noreferrer">
            Instagram<span class="visually-hidden"> (abre em nova aba)</span>
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="wrap legal">
    <p>© {year} {brand.fullName}. Todos os direitos reservados.</p>
    <a href="/privacidade">Política de privacidade</a>
  </div>
</footer>

<style>
  .site-footer {
    padding-top: 48px;
    border-top: 1px solid var(--color-line);
    background: var(--color-bg);
    font-size: 0.9375rem;
  }
  .grid {
    display: grid;
    grid-template-columns: 1.4fr repeat(3, 1fr);
    gap: 32px;
  }
  .about {
    display: grid;
    align-content: start;
    gap: 12px;
    max-width: 320px;
  }
  .about p {
    color: var(--color-muted);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--color-ink);
    font-weight: 800;
    text-decoration: none;
  }
  .about :global(.social) {
    justify-content: flex-start;
    margin-left: -10px;
  }
  .column h2 {
    margin-bottom: 10px;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink);
  }
  .column ul {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .column a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    color: var(--color-muted);
    text-decoration: none;
  }
  .column a:hover {
    color: var(--color-ink);
    text-decoration: underline;
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 36px;
    padding-top: 20px;
    padding-bottom: calc(24px + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid var(--color-line);
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
  .legal a {
    color: var(--color-muted);
  }
  @media (max-width: 860px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .about {
      grid-column: 1 / -1;
      max-width: none;
    }
  }
</style>
