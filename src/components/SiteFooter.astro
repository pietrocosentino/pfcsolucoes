---
import Logo from './Logo.astro';
import SocialLinks from './SocialLinks.astro';
import { assistant, brand, contact, footer } from '../data/site';

const year = new Date().getFullYear();
const summaryRest = footer.summary.slice(footer.summaryLink.length);
---

<footer class="site-footer">
  <div class="wrap grid">
    <div class="about">
      <a class="brand" href="/" aria-label={`${brand.fullName}, página inicial`}>
        <Logo size={34} knockout="var(--color-subtle)" />
        <span>{brand.fullName}</span>
      </a>
      <p><a class="summary-link" href="/">{footer.summaryLink}</a>{summaryRest}</p>
      <SocialLinks class="social" />
    </div>

    {footer.columns.map((column) => (
      <nav class="column" aria-label={column.title}>
        <p class="heading">{column.title}</p>
        <ul>
          {column.links.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </nav>
    ))}

    <div class="column contact">
      <p class="heading">Contato</p>
      <ul>
        <li>
          <a href="/#contato" data-chat-open aria-haspopup="dialog">
            Fale com a {assistant.name}
          </a>
        </li>
        <li>
          <a href={`mailto:${contact.email}`}>{contact.email}</a>
        </li>
        <li>
          <a href={contact.instagramProfile} target="_blank" rel="noopener noreferrer">
            Instagram<span class="visually-hidden"> (abre em nova aba)</span>
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="wrap legal">
    <p>© {year} {brand.fullName}. CNPJ {brand.cnpj}. Todos os direitos reservados.</p>
    <p>Atualizado em <time datetime={brand.updatedAt}>{brand.updatedLabel}</time></p>
    <a href="/privacidade">Política de privacidade</a>
  </div>
</footer>

<style>
  .site-footer {
    padding-top: var(--space-12);
    border-top: 1px solid var(--color-border);
    background: var(--color-subtle);
    font-size: var(--text-sm);
  }
  .grid {
    display: grid;
    grid-template-columns: 1.4fr repeat(3, 1fr);
    gap: var(--space-8);
  }
  .about {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    max-width: 320px;
  }
  .about p {
    color: var(--color-text-muted);
  }
  .summary-link {
    color: inherit;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-heading);
    font-weight: var(--weight-bold);
    text-decoration: none;
  }
  .about :global(.social) {
    justify-content: flex-start;
    margin-left: calc(-1 * var(--space-3));
  }
  .column .heading {
    margin-bottom: var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-heading);
  }
  .column ul {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .column a {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-sm);
    color: var(--color-text);
    text-decoration: none;
  }
  .column a:hover {
    color: var(--color-heading);
    text-decoration: underline;
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    padding-bottom: calc(var(--space-6) + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid var(--color-border);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .legal a {
    color: var(--color-text-muted);
  }
  @media (max-width: 860px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .about,
    .contact {
      grid-column: 1 / -1;
      max-width: none;
    }
  }
</style>
