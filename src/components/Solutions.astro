---
import Section from './Section.astro';
import SolutionCard from './SolutionCard.astro';
import Button from './Button.astro';
import { contact, solutions } from '../data/site';
---

<Section id="solucoes" tone="band" eyebrow={solutions.eyebrow} title={solutions.title} lead={solutions.lead}>
  <div class="cards">
    {solutions.items.map((solution) => <SolutionCard solution={solution} />)}
  </div>
  <div class="more">
    <p>{solutions.closing}</p>
    <Button href={contact.instagramDirect} external>Contar o meu problema</Button>
  </div>
</Section>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }
  @media (max-width: 700px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
  .more {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 28px;
    padding: 22px 26px;
    border-radius: var(--radius-md);
    border: 2px dashed var(--color-line);
  }
  .more p {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-ink);
  }
</style>
