---
import Section from './Section.astro';
import SolutionCard from './SolutionCard.astro';
import { contact, solutions } from '../data/site';
---

<Section id="solucoes" tone="band" eyebrow={solutions.eyebrow} title={solutions.title} lead={solutions.lead}>
  <div class="cards">
    {solutions.items.map((solution) => <SolutionCard solution={solution} />)}
  </div>
  <p class="more">{solutions.closing}</p>
  <p class="next"><a href={contact.whatsapp} data-chat-open aria-haspopup="dialog">{solutions.more}</a></p>
</Section>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }
  @media (max-width: 700px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
  .next {
    margin-top: 8px;
  }
  .next a {
    font-weight: 700;
    color: var(--color-accent-text);
  }
  .more {
    margin-top: 28px;
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-ink);
  }
</style>
