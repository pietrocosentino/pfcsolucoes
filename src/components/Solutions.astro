---
// O agente de IA, produto principal, aparece em destaque; os outros em grade menor.
import Section from './Section.astro';
import SolutionCard from './SolutionCard.astro';
import { contact, solutions } from '../data/site';

const [main, ...others] = solutions.items;
---

<Section id="solucoes" tone="band" title={solutions.title} lead={solutions.lead}>
  <SolutionCard solution={main} featured />
  <div class="cards">
    {others.map((solution) => <SolutionCard solution={solution} />)}
  </div>
  <p class="more">
    {solutions.closing} <a href={contact.whatsapp} data-chat-open aria-haspopup="dialog">{solutions.more}</a>.
  </p>
</Section>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    margin-top: var(--space-4);
  }
  @media (max-width: 900px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
  .more {
    margin-top: var(--space-8);
    font-size: var(--text-lg);
    color: var(--color-heading);
  }
  .more a {
    font-weight: var(--weight-bold);
    color: var(--color-accent);
  }
</style>
