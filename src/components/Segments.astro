---
// Faixa com os tipos de negócio atendidos: o visitante se reconhece antes de rolar.
import { segments } from '../data/site';
---

<div class="segments" aria-label="Tipos de negócio atendidos">
  <p class="wrap">
    <span class="label">{segments.label}</span>
    {segments.items.map((item, i) => (
      <>
        {i > 0 && <span class="dot" aria-hidden="true">·</span>}
        <span>{item}</span>
      </>
    ))}
  </p>
</div>

<style>
  .segments {
    border-block: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  p {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin: 0 auto;
    padding-block: var(--space-4);
    font-weight: var(--weight-semibold);
    color: var(--color-heading);
  }
  .label {
    color: var(--color-text-muted);
    font-weight: var(--weight-regular);
  }
  .dot {
    color: var(--color-text-muted);
  }
</style>
