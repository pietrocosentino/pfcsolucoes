---
// Faixa com os tipos de negócio atendidos: o visitante se reconhece antes de rolar.
import { segments } from '../data/site';
---

<div class="segments" aria-label="Tipos de negócio atendidos">
  <p class="wrap">
    <span class="label">{segments.label}</span>
    {segments.items.map((item, i) => (
      <>
        {i > 0 && <span class="dot" aria-hidden="true">·</span>}
        <span>{item}</span>
      </>
    ))}
  </p>
</div>

<style>
  .segments {
    border-block: 1px solid var(--color-line);
    background: var(--color-surface);
  }
  p {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    margin: 0 auto;
    padding-block: 16px;
    font-weight: 600;
    color: var(--color-ink);
  }
  .label {
    color: var(--color-muted);
    font-weight: 500;
  }
  .dot {
    color: var(--color-muted);
  }
</style>
