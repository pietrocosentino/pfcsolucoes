---
// Quem está por trás: texto à esquerda e fatos verificáveis (registro público) à direita.
import Section from './Section.astro';
import { about, brand } from '../data/site';

const facts = [
  { label: 'Experiência', value: '9 anos em tecnologia' },
  { label: 'Empresa aberta em', value: brand.foundingLabel },
  { label: 'Sede', value: `${brand.city}, ${brand.state} · atendimento em todo o Brasil` },
  { label: 'CNPJ', value: brand.cnpj },
];
---

<Section id="sobre" tone="band" title="Você fala com quem constrói">
  <div class="about">
    <div class="bio">
      <p class="lead">{about.short}</p>
      <p class="links">
        <a href="/sobre">Conhecer a PFC</a>
        <a href={about.linkedin} target="_blank" rel="noopener noreferrer">Pietro no LinkedIn<span class="visually-hidden"> (abre em nova aba)</span></a>
      </p>
    </div>
    <dl class="facts">
      {facts.map((fact) => (
        <div>
          <dt>{fact.label}</dt>
          <dd>{fact.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</Section>

<style>
  .about {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: var(--space-12);
    align-items: start;
  }
  .bio {
    display: grid;
    gap: var(--space-6);
    justify-items: start;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    font-weight: var(--weight-bold);
  }
  .facts {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--color-border);
  }
  .facts div {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }
  dt {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  dd {
    margin: 0;
    font-weight: var(--weight-semibold);
    color: var(--color-heading);
  }
  @media (max-width: 760px) {
    .about {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
