---
// Quem está por trás: texto à esquerda; fatos da empresa e de quem atende, separados, à direita.
import Section from './Section.astro';
import { about, brand } from '../data/site';

const groups = [
  {
    title: 'A empresa',
    facts: [
      { label: 'Razão social', value: brand.legalName },
      { label: 'CNPJ', value: brand.cnpj },
      { label: 'Aberta em', value: brand.foundingLabel },
      { label: 'Sede', value: `${brand.city}, ${brand.state} · atendimento em todo o Brasil` },
    ],
  },
  {
    title: 'Quem atende',
    facts: [
      { label: 'Nome', value: about.name },
      { label: 'Papel na PFC', value: 'Fundador' },
      { label: 'Experiência', value: '9 anos em tecnologia' },
    ],
  },
];
---

<Section id="sobre" title="Você fala com quem constrói">
  <div class="about">
    <div class="bio">
      <p class="lead">{about.short}</p>
      <a class="link-arrow" href="/sobre">Conhecer a PFC</a>
    </div>
    <div class="groups">
      {groups.map((group) => (
        <div class="group">
          <h3 class="label-caps group-title">{group.title}</h3>
          <dl>
            {group.facts.map((fact) => (
              <div>
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))}
          </dl>
          {group.title === 'Quem atende' && (
            <a class="link-arrow" href={about.linkedin} target="_blank" rel="noopener noreferrer">
              Pietro no LinkedIn<span class="visually-hidden"> (abre em nova aba)</span>
            </a>
          )}
        </div>
      ))}
    </div>
  </div>
</Section>

<style>
  .about {
    display: grid;
    grid-template-columns: 2fr 3fr;
    gap: var(--space-12);
    align-items: start;
  }
  .bio {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }
  .groups {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-8);
  }
  .group {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    justify-items: start;
  }
  .group-title {
    color: var(--color-text-muted);
  }
  dl {
    display: grid;
    width: 100%;
    margin: 0;
    border-top: 1px solid var(--color-border);
  }
  dl div {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }
  dt {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  dd {
    margin: 0;
    font-weight: var(--weight-semibold);
    color: var(--color-heading);
    overflow-wrap: anywhere;
  }
  @media (max-width: 900px) {
    .about {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
  @media (max-width: 560px) {
    .groups {
      grid-template-columns: 1fr;
    }
  }
</style>
