---
import Section from './Section.astro';
import Button from './Button.astro';
import { about } from '../data/site';
---

<Section id="sobre" tone="band" title="Quem faz">
  <div class="about">
    <div class="bio">
      <p class="lead">{about.short}</p>
      <div class="actions">
        <Button href="/sobre">Conheça a PFC</Button>
        <Button href={about.linkedin} variant="secondary" external>Pietro no LinkedIn</Button>
      </div>
    </div>
  </div>
</Section>

<style>
  .about {
    max-width: var(--width-narrow);
  }
  .bio {
    display: grid;
    gap: var(--space-6);
    justify-items: start;
  }
</style>
