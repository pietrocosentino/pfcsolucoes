---
import Logo from './Logo.astro';
import { brand, navigation } from '../data/site';

// Na página inicial o logo sobe para o topo; nas outras, leva à página inicial.
const home = Astro.url.pathname === '/';
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={home ? '#inicio' : '/'}>
      <Logo size={38} knockout="var(--color-subtle)" />
      <span class="brand-text">
        <strong>{brand.name}</strong>
        <span>{brand.tagline}</span>
      </span>
      <span class="visually-hidden">, {home ? 'voltar ao início' : 'página inicial'}</span>
    </a>

    <nav class="nav" aria-label="Principal">
      <ul>
        {navigation.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-subtle) 94%, transparent);
    backdrop-filter: saturate(140%) blur(8px);
    border-bottom: 1px solid var(--color-border);
    padding-top: env(safe-area-inset-top, 0px);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    min-height: var(--space-16);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-heading);
    text-decoration: none;
    margin-right: auto;
  }
  .brand-text {
    display: grid;
    line-height: var(--leading-snug);
  }
  .brand-text strong {
    font-size: var(--text-md);
    font-weight: var(--weight-bold);
  }
  .brand-text span {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .nav ul {
    display: flex;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-sm);
    padding: 0 var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--color-heading);
    font-weight: var(--weight-semibold);
    font-size: var(--text-sm);
    text-decoration: none;
  }
  .nav a:hover {
    background: var(--color-subtle);
  }

  /* Celular: a navegação desce para uma segunda linha, toda visível. */
  @media (max-width: 760px) {
    .bar {
      flex-wrap: wrap;
      gap: 0 var(--space-3);
      padding-top: var(--space-2);
    }
    .brand-text span {
      display: none;
    }
    .nav {
      order: 3;
      width: 100%;
      border-top: 1px solid var(--color-border);
    }
    .nav ul {
      justify-content: space-between;
      gap: 0;
    }
    .nav a {
      padding: 0;
      font-size: clamp(var(--text-xs), 3.6vw, var(--text-sm)); /* cabe em telas de 320px */
      white-space: nowrap;
    }
  }
</style>
