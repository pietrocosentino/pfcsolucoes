---
// Abertura das páginas internas (Quem somos, Privacidade, Condições): sobrancelha, h1, texto e data.
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  updatedAt?: string;
}

const { eyebrow, title, lead, updatedAt } = Astro.props;
---

<section class="intro" aria-labelledby="pagina-titulo">
  <div class="wrap content">
    <p class="eyebrow">{eyebrow}</p>
    <h1 id="pagina-titulo">{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    {updatedAt && <p class="updated">Última atualização: {updatedAt}</p>}
    <slot />
  </div>
</section>

<style>
  .intro {
    background: var(--color-subtle);
    padding-block: clamp(var(--space-12), 6vw, var(--space-16));
  }
  .content {
    display: grid;
    gap: var(--space-4);
  }
  h1 {
    max-width: var(--measure-title);
  }
  .updated {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
</style>
