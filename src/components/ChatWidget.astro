---
// Janela do atendente de IA. Qualquer link com `data-chat-open` abre o chat; sem
// JavaScript esses links continuam levando ao WhatsApp.
import { assistant, contact } from '../data/site';

const greeting = assistant.greeting;
const suggestions = [
  'Perco clientes no WhatsApp',
  'Quero agenda online',
  'Quero organizar as finanças',
  'Preciso de um site',
];
---

<button type="button" class="launcher" data-chat-open aria-haspopup="dialog" aria-controls="chat-panel" hidden>
  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
    <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v8a2.5 2.5 0 0 1-2.5 2.5H10l-4.2 3.6c-.5.4-1.3.1-1.3-.6V16A2.5 2.5 0 0 1 4 13.5v-8Z" fill="currentColor" />
  </svg>
  <span>{assistant.launcher}</span>
</button>

<section
  id="chat-panel"
  class="panel"
  role="dialog"
  aria-modal="false"
  aria-labelledby="chat-title"
  hidden
  data-greeting={greeting}
  data-name={assistant.name}
  data-whatsapp={contact.whatsapp}
>
  <div class="top">
    <span class="avatar" aria-hidden="true">M</span>
    <div class="who">
      <h2 id="chat-title">{assistant.name}</h2>
      <p>{assistant.status}</p>
    </div>
    <button type="button" class="close" data-chat-close aria-label="Fechar o chat">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <ol class="log" aria-live="polite" aria-label="Mensagens"></ol>

  <div class="chips" data-chips>
    {suggestions.map((text) => <button type="button" class="chip" data-suggestion={text}>{text}</button>)}
  </div>

  <form class="composer" novalidate>
    <label for="chat-input" class="visually-hidden">Sua mensagem</label>
    <textarea id="chat-input" rows="1" maxlength="1000" placeholder="Escreva sua mensagem" autocomplete="off"></textarea>
    <button type="submit" class="send" aria-label="Enviar">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
        <path d="M4 12l15-7-5 15-2.5-6.2L4 12Z" fill="currentColor" />
      </svg>
    </button>
  </form>
  <p class="foot">A {assistant.name} é uma atendente com IA. Quer falar com o Pietro? É só pedir.</p>
</section>

<script>
  type Message = { role: 'user' | 'assistant'; text: string; handoff?: string };

  const panel = document.getElementById('chat-panel') as HTMLElement;
  const log = panel.querySelector('.log') as HTMLOListElement;
  const form = panel.querySelector('form') as HTMLFormElement;
  const input = panel.querySelector('textarea') as HTMLTextAreaElement;
  const send = panel.querySelector('.send') as HTMLButtonElement;
  const chips = panel.querySelector('[data-chips]') as HTMLElement;
  const launcher = document.querySelector('.launcher') as HTMLButtonElement;
  const whatsapp = panel.dataset.whatsapp!;
  const STORAGE_KEY = 'pfc-chat';

  let messages: Message[] = [];
  let busy = false;
  let opener: HTMLElement | null = null;

  try {
    messages = JSON.parse(sessionStorage.getItem(STORAGE_KEY) || '[]');
  } catch {
    messages = [];
  }
  if (!Array.isArray(messages) || messages.length === 0) {
    messages = [{ role: 'assistant', text: panel.dataset.greeting! }];
  }

  const save = () => {
    try {
      sessionStorage.setItem(STORAGE_KEY, JSON.stringify(messages));
    } catch {
      /* navegação privada: a conversa vale só enquanto a página estiver aberta */
    }
  };

  const whatsappLink = (href: string, label: string) => {
    const a = document.createElement('a');
    a.href = href;
    a.target = '_blank';
    a.rel = 'noopener noreferrer';
    a.className = 'handoff';
    a.textContent = label;
    const hint = document.createElement('span');
    hint.className = 'visually-hidden';
    hint.textContent = ' (abre em nova aba)';
    a.append(hint);
    return a;
  };

  const addBubble = (message: Message) => {
    const li = document.createElement('li');
    li.className = `msg msg--${message.role}`;
    const who = document.createElement('span');
    who.className = 'visually-hidden';
    who.textContent = message.role === 'user' ? 'Você: ' : `${panel.dataset.name}: `;
    const p = document.createElement('p');
    p.append(who, message.text);
    li.append(p);
    if (message.handoff) li.append(whatsappLink(message.handoff, 'Abrir WhatsApp com o resumo'));
    log.append(li);
    log.scrollTop = log.scrollHeight;
  };

  const addNotice = (text: string) => {
    const li = document.createElement('li');
    li.className = 'msg msg--notice';
    const p = document.createElement('p');
    p.textContent = text;
    li.append(p, whatsappLink(whatsapp, 'Continuar pelo WhatsApp'));
    log.append(li);
    log.scrollTop = log.scrollHeight;
  };

  const render = () => {
    log.replaceChildren();
    messages.forEach(addBubble);
    chips.hidden = messages.some((m) => m.role === 'user');
  };

  const setBusy = (value: boolean) => {
    busy = value;
    send.disabled = value;
    panel.toggleAttribute('aria-busy', value);
    const typing = log.querySelector('.msg--typing');
    if (value && !typing) {
      const li = document.createElement('li');
      li.className = 'msg msg--assistant msg--typing';
      li.innerHTML = `<p><span class="visually-hidden">${panel.dataset.name} digitando</span><i></i><i></i><i></i></p>`;
      log.append(li);
      log.scrollTop = log.scrollHeight;
    } else if (!value) typing?.remove();
  };

  const ask = async (text: string) => {
    const clean = text.trim();
    if (!clean || busy) return;
    messages.push({ role: 'user', text: clean.slice(0, 1000) });
    save();
    render();
    setBusy(true);
    try {
      const response = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ messages: messages.map(({ role, text }) => ({ role, text })) }),
      });
      const data = await response.json().catch(() => ({}));
      setBusy(false);
      if (!response.ok || !data.reply) {
        addNotice(data.error || 'O atendente está indisponível agora.');
        return;
      }
      messages.push({ role: 'assistant', text: data.reply, handoff: data.handoff?.url });
      save();
      addBubble(messages[messages.length - 1]);
    } catch {
      setBusy(false);
      addNotice('Sem conexão com o atendente agora.');
    }
  };

  const open = (from?: HTMLElement) => {
    opener = from ?? null;
    render();
    panel.hidden = false;
    launcher.setAttribute('aria-expanded', 'true');
    document.body.classList.add('chat-open');
    input.focus();
  };

  const close = () => {
    panel.hidden = true;
    launcher.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('chat-open');
    (opener ?? launcher).focus();
  };

  launcher.hidden = false;
  launcher.setAttribute('aria-expanded', 'false');

  document.addEventListener('click', (event) => {
    const trigger = (event.target as HTMLElement).closest<HTMLElement>('[data-chat-open]');
    if (!trigger) return;
    event.preventDefault();
    if (panel.hidden) open(trigger);
    else input.focus();
  });
  panel.querySelector('[data-chat-close]')!.addEventListener('click', close);
  panel.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') close();
  });
  chips.addEventListener('click', (event) => {
    const chip = (event.target as HTMLElement).closest<HTMLElement>('[data-suggestion]');
    if (chip) ask(chip.dataset.suggestion!);
  });
  form.addEventListener('submit', (event) => {
    event.preventDefault();
    const text = input.value;
    input.value = '';
    input.style.height = '';
    ask(text);
  });
  input.addEventListener('keydown', (event) => {
    if (event.key === 'Enter' && !event.shiftKey) {
      event.preventDefault();
      form.requestSubmit();
    }
  });
  input.addEventListener('input', () => {
    input.style.height = '';
    input.style.height = `${Math.min(input.scrollHeight, 120)}px`;
  });
</script>

<style>
  .launcher {
    position: fixed;
    right: max(16px, env(safe-area-inset-right, 0px));
    bottom: max(16px, env(safe-area-inset-bottom, 0px));
    z-index: 60;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 52px;
    padding: 12px 20px;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--color-button);
    color: var(--color-button-text);
    font: 700 1rem/1 var(--font-sans);
    box-shadow: 0 12px 28px -10px rgb(27 42 74 / 0.55);
    cursor: pointer;
  }
  .launcher:hover {
    background: var(--color-button-hover);
  }
  .launcher[hidden],
  :global(body.chat-open) .launcher {
    display: none;
  }

  .panel {
    position: fixed;
    right: max(16px, env(safe-area-inset-right, 0px));
    bottom: max(16px, env(safe-area-inset-bottom, 0px));
    z-index: 70;
    display: flex;
    flex-direction: column;
    width: min(400px, calc(100vw - 32px));
    height: min(620px, calc(100dvh - 32px));
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: 0 24px 60px -20px rgb(27 42 74 / 0.5);
    overflow: hidden;
  }
  .panel[hidden] {
    display: none;
  }

  .top {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 12px 12px 16px;
    background: var(--brand-navy);
    color: #ffffff;
  }
  .avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #c8401d;
    font-weight: 800;
    font-size: 0.8125rem;
  }
  .who {
    flex: 1;
    line-height: 1.25;
  }
  .who h2 {
    color: #ffffff;
    font-size: 1rem;
    letter-spacing: 0;
  }
  .who p {
    font-size: 0.8125rem;
    color: #c9d2e3;
  }
  .close {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: #ffffff;
    cursor: pointer;
  }
  .close:hover {
    background: rgb(255 255 255 / 0.12);
  }

  .log {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 16px;
    overflow-y: auto;
    list-style: none;
    background: var(--color-chip);
  }
  .log :global(.msg) {
    display: grid;
    gap: 8px;
    max-width: 88%;
  }
  .log :global(.msg p) {
    padding: 10px 13px;
    border-radius: 14px;
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--color-ink);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .log :global(.msg--assistant),
  .log :global(.msg--notice) {
    align-self: flex-start;
  }
  .log :global(.msg--assistant p),
  .log :global(.msg--notice p) {
    background: var(--color-surface);
    border-bottom-left-radius: 4px;
  }
  .log :global(.msg--user) {
    align-self: flex-end;
  }
  .log :global(.msg--user p) {
    background: var(--color-bubble-out);
    border-bottom-right-radius: 4px;
  }
  .log :global(.handoff) {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 10px 16px;
    border-radius: var(--radius-pill);
    background: var(--color-button);
    color: var(--color-button-text);
    font-weight: 700;
    font-size: 0.9375rem;
    text-decoration: none;
  }
  .log :global(.msg--typing i) {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin: 0 2px;
    border-radius: 50%;
    background: var(--color-muted);
    animation: blink 1.2s infinite ease-in-out;
  }
  .log :global(.msg--typing i:nth-child(3)) {
    animation-delay: 0.2s;
  }
  .log :global(.msg--typing i:nth-child(4)) {
    animation-delay: 0.4s;
  }
  @keyframes blink {
    0%,
    80%,
    100% {
      opacity: 0.25;
    }
    40% {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .log :global(.msg--typing i) {
      animation: none;
    }
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0 16px 12px;
    background: var(--color-chip);
  }
  .chips[hidden] {
    display: none;
  }
  .chip {
    min-height: 40px;
    padding: 8px 14px;
    border: 1.5px solid var(--color-ink);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-ink);
    font: 600 0.875rem/1.2 var(--font-sans);
    cursor: pointer;
  }
  .chip:hover {
    background: var(--color-ink);
    color: var(--color-surface);
  }

  .composer {
    display: flex;
    align-items: flex-end;
    gap: 8px;
    padding: 12px;
    border-top: 1px solid var(--color-line);
  }
  textarea {
    flex: 1;
    min-height: 44px;
    max-height: 120px;
    padding: 11px 14px;
    border: 1.5px solid var(--color-line);
    border-radius: 22px;
    background: var(--color-bg);
    color: var(--color-ink);
    font: 400 1rem/1.35 var(--font-sans); /* 16px evita zoom automático no iPhone */
    resize: none;
  }
  textarea::placeholder {
    color: var(--color-muted);
  }
  .send {
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: var(--color-button);
    color: var(--color-button-text);
    cursor: pointer;
  }
  .send:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .foot {
    padding: 0 12px 10px;
    font-size: 0.75rem;
    color: var(--color-muted);
    text-align: center;
  }

  /* Celular: o chat ocupa a tela inteira. */
  @media (max-width: 560px) {
    .panel {
      inset: 0;
      width: 100%;
      height: 100dvh;
      border: 0;
      border-radius: 0;
      padding-top: env(safe-area-inset-top, 0px);
      padding-bottom: env(safe-area-inset-bottom, 0px);
    }
    .launcher span {
      /* some o texto, mas ele continua sendo o nome do botão para leitores de tela */
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    .launcher {
      width: 56px;
      height: 56px;
      padding: 0;
      justify-content: center;
    }
  }
</style>
