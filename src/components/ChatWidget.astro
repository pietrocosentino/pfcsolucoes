---
// Janela do atendente de IA. Qualquer link com `data-chat-open` abre o chat; sem
// JavaScript esses links continuam levando ao WhatsApp.
import { assistant, contact } from '../data/site';

const greeting = assistant.greeting;
---

<button type="button" class="launcher" data-chat-open aria-haspopup="dialog" aria-controls="chat-panel" hidden>
  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
    <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v8a2.5 2.5 0 0 1-2.5 2.5H10l-4.2 3.6c-.5.4-1.3.1-1.3-.6V16A2.5 2.5 0 0 1 4 13.5v-8Z" fill="currentColor" />
  </svg>
  <span>{assistant.launcher}</span>
</button>

<section
  id="chat-panel"
  class="panel"
  role="dialog"
  aria-modal="false"
  aria-labelledby="chat-title"
  hidden
  data-greeting={greeting}
  data-suggestions={JSON.stringify(assistant.suggestions)}
  data-name={assistant.name}
  data-whatsapp={contact.whatsapp}
>
  <div class="top">
    <span class="avatar" aria-hidden="true">M</span>
    <div class="who">
      <h2 id="chat-title">{assistant.name}</h2>
      <p>{assistant.status}</p>
    </div>
    <button type="button" class="close" data-chat-close aria-label="Fechar o chat">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <ol class="log" aria-live="polite" aria-label="Mensagens"></ol>

  <form class="composer" novalidate>
    <label for="chat-input" class="visually-hidden">Sua mensagem</label>
    <textarea id="chat-input" rows="1" maxlength="1000" placeholder="Escreva sua mensagem" autocomplete="off"></textarea>
    <button type="submit" class="send" aria-label="Enviar">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
        <path d="M4 12l15-7-5 15-2.5-6.2L4 12Z" fill="currentColor" />
      </svg>
    </button>
  </form>
  <p class="foot">A {assistant.name} é uma atendente virtual com inteligência artificial. <a href="/privacidade">Privacidade</a></p>
</section>

<script>
  type Message = { role: 'user' | 'assistant'; text: string; handoff?: string };

  const panel = document.getElementById('chat-panel') as HTMLElement;
  const log = panel.querySelector('.log') as HTMLOListElement;
  const form = panel.querySelector('form') as HTMLFormElement;
  const input = panel.querySelector('textarea') as HTMLTextAreaElement;
  const send = panel.querySelector('.send') as HTMLButtonElement;
  const launcher = document.querySelector('.launcher') as HTMLButtonElement;
  const whatsapp = panel.dataset.whatsapp!;
  const STORAGE_KEY = 'pfc-chat';
  // Depois de 5 minutos sem atividade, a conversa é apagada e a marcIA recomeça.
  const IDLE_MS = 5 * 60 * 1000;

  const greetingOnly = (): Message[] => [{ role: 'assistant', text: panel.dataset.greeting! }];

  let messages: Message[] = greetingOnly();
  let lastActivity = Date.now();
  let idleTimer: number | undefined;
  let busy = false;
  let opener: HTMLElement | null = null;

  // Formato salvo: { messages, at }. Conversa antiga, sem data, ou parada há
  // mais de 5 minutos não é restaurada.
  try {
    const saved = JSON.parse(sessionStorage.getItem(STORAGE_KEY) || 'null');
    if (saved && Array.isArray(saved.messages) && saved.messages.length && Date.now() - saved.at < IDLE_MS) {
      messages = saved.messages;
      lastActivity = saved.at;
    } else {
      sessionStorage.removeItem(STORAGE_KEY);
    }
  } catch {
    /* armazenamento indisponível: começa do zero */
  }

  const hasConversation = () => messages.some((m) => m.role === 'user');

  const scheduleExpiry = () => {
    window.clearTimeout(idleTimer);
    if (!hasConversation()) return;
    idleTimer = window.setTimeout(expireIfIdle, Math.max(0, IDLE_MS - (Date.now() - lastActivity)));
  };

  const touch = () => {
    lastActivity = Date.now();
    scheduleExpiry();
  };

  const save = () => {
    touch();
    try {
      sessionStorage.setItem(STORAGE_KEY, JSON.stringify({ messages, at: lastActivity }));
    } catch {
      /* navegação privada: a conversa vale só enquanto a página estiver aberta */
    }
  };

  const whatsappLink = (href: string, label: string) => {
    const a = document.createElement('a');
    a.href = href;
    a.target = '_blank';
    a.rel = 'noopener noreferrer';
    a.className = 'handoff';
    a.textContent = label;
    const hint = document.createElement('span');
    hint.className = 'visually-hidden';
    hint.textContent = ' (abre em nova aba)';
    a.append(hint);
    return a;
  };

  const addBubble = (message: Message) => {
    const li = document.createElement('li');
    li.className = `msg msg--${message.role}`;
    const who = document.createElement('span');
    who.className = 'visually-hidden';
    who.textContent = message.role === 'user' ? 'Você: ' : `${panel.dataset.name}: `;
    const p = document.createElement('p');
    p.append(who, message.text);
    li.append(p);
    if (message.handoff) li.append(whatsappLink(message.handoff, 'Abrir WhatsApp com o resumo'));
    log.append(li);
    log.scrollTop = log.scrollHeight;
  };

  const addNotice = (text: string) => {
    const li = document.createElement('li');
    li.className = 'msg msg--notice';
    const p = document.createElement('p');
    p.textContent = text;
    li.append(p, whatsappLink(whatsapp, 'Continuar pelo WhatsApp'));
    log.append(li);
    log.scrollTop = log.scrollHeight;
  };

  // Antes da primeira mensagem, respostas prontas para tocar (o visitante não
  // precisa saber como começar). Somem assim que a conversa começa.
  const suggestions: string[] = JSON.parse(panel.dataset.suggestions || '[]');
  const addSuggestions = () => {
    if (hasConversation() || !suggestions.length) return;
    const li = document.createElement('li');
    li.className = 'msg msg--suggestions';
    li.setAttribute('aria-label', 'Respostas prontas');
    for (const text of suggestions) {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'suggestion';
      button.textContent = text;
      button.addEventListener('click', () => ask(text));
      li.append(button);
    }
    log.append(li);
  };

  const render = () => {
    log.replaceChildren();
    messages.forEach(addBubble);
    addSuggestions();
  };

  const addInfo = (text: string) => {
    const li = document.createElement('li');
    li.className = 'msg msg--info';
    const p = document.createElement('p');
    p.textContent = text;
    li.append(p);
    log.prepend(li);
  };

  function expireIfIdle() {
    if (!hasConversation()) return;
    // Enquanto a marcIA responde ou o visitante digita, a conversa segue ativa.
    if (busy || input.value.trim()) {
      touch();
      return;
    }
    if (Date.now() - lastActivity < IDLE_MS) {
      scheduleExpiry();
      return;
    }
    window.clearTimeout(idleTimer);
    messages = greetingOnly();
    try {
      sessionStorage.removeItem(STORAGE_KEY);
    } catch {
      /* nada a apagar */
    }
    render();
    addInfo('A conversa anterior foi encerrada depois de 5 minutos sem resposta.');
  }

  const setBusy = (value: boolean) => {
    busy = value;
    send.disabled = value;
    panel.toggleAttribute('aria-busy', value);
    const typing = log.querySelector('.msg--typing');
    if (value && !typing) {
      const li = document.createElement('li');
      li.className = 'msg msg--assistant msg--typing';
      li.innerHTML = `<p><span class="visually-hidden">${panel.dataset.name} digitando</span><i></i><i></i><i></i></p>`;
      log.append(li);
      log.scrollTop = log.scrollHeight;
    } else if (!value) typing?.remove();
  };

  const ask = async (text: string) => {
    const clean = text.trim();
    if (!clean || busy) return;
    messages.push({ role: 'user', text: clean.slice(0, 1000) });
    save();
    render();
    setBusy(true);
    try {
      const response = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ messages: messages.map(({ role, text }) => ({ role, text })) }),
      });
      const data = await response.json().catch(() => ({}));
      setBusy(false);
      if (!response.ok || !data.reply) {
        addNotice(data.error || 'O atendente está indisponível agora.');
        return;
      }
      messages.push({ role: 'assistant', text: data.reply, handoff: data.handoff?.url });
      save();
      addBubble(messages[messages.length - 1]);
    } catch {
      setBusy(false);
      addNotice('Sem conexão com o atendente agora.');
    }
  };

  const open = (from?: HTMLElement) => {
    opener = from ?? null;
    render();
    expireIfIdle();
    panel.hidden = false;
    launcher.setAttribute('aria-expanded', 'true');
    document.body.classList.add('chat-open');
    input.focus();
  };

  const close = () => {
    panel.hidden = true;
    launcher.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('chat-open');
    (opener ?? launcher).focus();
  };

  launcher.hidden = false;
  launcher.setAttribute('aria-expanded', 'false');

  // Na página inicial, o topo já tem o botão principal: o flutuante só aparece
  // depois que ele sai da tela, para não cobrir o conteúdo.
  const hero = document.getElementById('inicio');
  if (hero && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => launcher.classList.toggle('is-away', entry.isIntersecting), {
      threshold: 0.15,
    }).observe(hero);
  }

  document.addEventListener('click', (event) => {
    const trigger = (event.target as HTMLElement).closest<HTMLElement>('[data-chat-open]');
    if (!trigger) return;
    event.preventDefault();
    if (panel.hidden) open(trigger);
    else input.focus();
  });
  panel.querySelector('[data-chat-close]')!.addEventListener('click', close);
  panel.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') close();
  });
  form.addEventListener('submit', (event) => {
    event.preventDefault();
    const text = input.value;
    input.value = '';
    input.style.height = '';
    ask(text);
  });
  input.addEventListener('keydown', (event) => {
    if (event.key === 'Enter' && !event.shiftKey) {
      event.preventDefault();
      form.requestSubmit();
    }
  });
  // O navegador atrasa cronômetros em abas escondidas; ao voltar, confere de novo.
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') expireIfIdle();
  });
  scheduleExpiry();

  input.addEventListener('input', () => {
    if (hasConversation()) touch();
    input.style.height = '';
    input.style.height = `${Math.min(input.scrollHeight, 120)}px`;
  });
</script>

<style>
  .launcher {
    position: fixed;
    right: max(16px, env(safe-area-inset-right, 0px));
    bottom: max(16px, env(safe-area-inset-bottom, 0px));
    z-index: 60;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--control-md);
    padding: var(--space-3) var(--space-6);
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--color-action);
    color: var(--color-on-action);
    font: var(--weight-bold) var(--text-md) / 1 var(--font-sans);
    box-shadow: var(--shadow-overlay);
    cursor: pointer;
  }
  .launcher:hover {
    background: var(--color-action-hover);
  }
  .launcher[hidden],
  :global(body.chat-open) .launcher {
    display: none;
  }
  .launcher {
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
  }
  .launcher.is-away {
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px);
  }
  @media (prefers-reduced-motion: reduce) {
    .launcher {
      transition: none;
    }
  }

  .log :global(.msg--suggestions) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-self: stretch;
    max-width: none;
    padding: 0;
    background: none;
  }
  .log :global(.suggestion) {
    min-height: var(--control-sm);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-accent);
    font: var(--weight-semibold) var(--text-sm) / var(--leading-snug) var(--font-sans);
    text-align: left;
    cursor: pointer;
  }
  .log :global(.suggestion:hover) {
    background: var(--color-subtle);
  }

  .panel {
    position: fixed;
    right: max(16px, env(safe-area-inset-right, 0px));
    bottom: max(16px, env(safe-area-inset-bottom, 0px));
    z-index: 70;
    display: flex;
    flex-direction: column;
    width: min(400px, calc(100vw - 32px));
    height: min(620px, calc(100dvh - 32px));
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-overlay);
    overflow: hidden;
  }
  .panel[hidden] {
    display: none;
  }

  .top {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-3) var(--space-3) var(--space-4);
    background: var(--dark-bg);
    color: var(--dark-text);
  }
  .avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: var(--control-sm);
    height: var(--control-sm);
    border-radius: var(--radius-pill);
    background: var(--dark-action);
    color: var(--dark-bg);
    font-weight: var(--weight-bold);
    font-size: var(--text-sm);
  }
  .who {
    flex: 1;
    line-height: var(--leading-snug);
  }
  .who h2 {
    color: var(--dark-text);
    font-size: var(--text-md);
    letter-spacing: 0;
  }
  .who p {
    font-size: var(--text-sm);
    color: var(--dark-muted);
  }
  .close {
    display: grid;
    place-items: center;
    width: var(--control-sm);
    height: var(--control-sm);
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--dark-text);
    cursor: pointer;
  }
  .close:hover {
    background: rgb(255 255 255 / 0.12);
  }
  .close:focus-visible {
    outline-color: var(--dark-focus);
    outline-offset: -3px;
  }

  .log {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: 0;
    padding: var(--space-4);
    overflow-y: auto;
    list-style: none;
    background: var(--color-bg);
  }
  .log :global(.msg) {
    display: grid;
    gap: var(--space-2);
    max-width: 88%;
  }
  .log :global(.msg p) {
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    font-size: var(--text-md);
    line-height: var(--leading-normal);
    color: var(--color-heading);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .log :global(.msg--assistant),
  .log :global(.msg--notice) {
    align-self: flex-start;
  }
  .log :global(.msg--assistant p),
  .log :global(.msg--notice p) {
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-border);
    border-bottom-left-radius: var(--space-1);
  }
  .log :global(.msg--user) {
    align-self: flex-end;
  }
  .log :global(.msg--user p) {
    background: var(--color-subtle);
    border-bottom-right-radius: var(--space-1);
  }
  .log :global(.msg--info) {
    align-self: center;
    max-width: 100%;
  }
  .log :global(.msg--info p) {
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-align: center;
  }
  .log :global(.handoff) {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: var(--control-sm);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-pill);
    background: var(--color-action);
    color: var(--color-on-action);
    font-weight: var(--weight-bold);
    font-size: var(--text-sm);
    text-decoration: none;
  }
  .log :global(.msg--typing i) {
    display: inline-block;
    width: var(--space-2);
    height: var(--space-2);
    margin: 0 2px;
    border-radius: var(--radius-pill);
    background: var(--color-text-muted);
    animation: blink 1.2s infinite ease-in-out;
  }
  .log :global(.msg--typing i:nth-child(3)) {
    animation-delay: 0.2s;
  }
  .log :global(.msg--typing i:nth-child(4)) {
    animation-delay: 0.4s;
  }
  @keyframes blink {
    0%,
    80%,
    100% {
      opacity: 0.25;
    }
    40% {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .log :global(.msg--typing i) {
      animation: none;
    }
  }

  .composer {
    display: flex;
    align-items: flex-end;
    gap: var(--space-2);
    padding: var(--space-3);
    border-top: 1px solid var(--color-border);
  }
  textarea {
    flex: 1;
    min-height: var(--control-sm);
    max-height: 120px;
    padding: 10px var(--space-4); /* 10 + 1 de borda: texto centrado em 44px */
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-heading);
    font: var(--weight-regular) var(--text-md) / 1.375 var(--font-sans); /* 16px evita zoom automático no iPhone */
    resize: none;
  }
  textarea:hover {
    border-color: var(--color-text);
  }
  textarea:disabled {
    background: var(--color-disabled-bg);
    color: var(--color-disabled-text);
  }
  textarea::placeholder {
    color: var(--color-text-muted);
  }
  .send {
    display: grid;
    place-items: center;
    flex: none;
    width: var(--control-sm);
    height: var(--control-sm);
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--color-action);
    color: var(--color-on-action);
    cursor: pointer;
  }
  .send:hover {
    background: var(--color-action-hover);
  }
  .send:disabled {
    background: var(--color-disabled-bg);
    color: var(--color-disabled-text);
    cursor: progress;
  }
  .foot {
    padding: 0 var(--space-3) var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-align: center;
  }

  /* Celular: o chat ocupa a tela inteira. */
  @media (max-width: 560px) {
    .panel {
      inset: 0;
      width: 100%;
      height: 100dvh;
      border: 0;
      border-radius: 0;
      padding-top: env(safe-area-inset-top, 0px);
      padding-bottom: env(safe-area-inset-bottom, 0px);
    }
    .launcher span {
      /* some o texto, mas ele continua sendo o nome do botão para leitores de tela */
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    .launcher {
      width: var(--control-md);
      height: var(--control-md);
      padding: 0;
      justify-content: center;
    }
  }
</style>
