---
import type { Solution } from '../data/site';

interface Props {
  solution: Solution;
  // Cartão largo, com os recursos em duas colunas.
  featured?: boolean;
}

const { solution, featured = false } = Astro.props;
// Âncora própria de cada cartão (o rodapé linka direto para ele).
const id = `solucao-${solution.area.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/\s+/g, '-')}`;
---

<article class:list={['card', { featured }]} id={id}>
  <p class="area">{solution.area}</p>
  <h3>{solution.title}</h3>
  <p class="description">{solution.description}</p>
  <ul class="features">
    {solution.features.map((feature) => <li>{feature}</li>)}
  </ul>
  <p class="project"><strong>Projeto entregue:</strong> {solution.project}</p>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 26px;
    border-radius: var(--radius-md);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
  }
  .area {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .description {
    color: var(--color-muted);
  }
  .features {
    display: grid;
    gap: 6px;
    margin: 4px 0 0;
    padding-left: 1.1em;
    color: var(--color-text);
  }
  .features li::marker {
    color: var(--color-muted);
  }
  .featured {
    padding: 32px;
    border-color: var(--color-accent-text);
  }
  .featured h3 {
    font-size: clamp(1.25rem, 2.4vw, 1.5rem);
  }
  .featured .features {
    grid-template-columns: repeat(2, 1fr);
    column-gap: 40px;
  }
  @media (max-width: 760px) {
    .featured .features {
      grid-template-columns: 1fr;
    }
  }
  .project {
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid var(--color-line);
    font-size: 0.875rem;
    color: var(--color-muted);
  }
  .project strong {
    color: var(--color-ink);
  }
</style>
