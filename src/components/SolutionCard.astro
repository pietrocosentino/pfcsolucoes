---
import { Image } from 'astro:assets';
import type { Solution } from '../data/site';
import painelHoje from '../assets/prints/painel-hoje.png';

const shots = { 'painel-hoje': painelHoje };

interface Props {
  solution: Solution;
  // Cartão largo, com os recursos em duas colunas.
  featured?: boolean;
}

const { solution, featured = false } = Astro.props;
// Âncora própria de cada cartão (o rodapé linka direto para ele).
const id = `solucao-${solution.area.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/\s+/g, '-')}`;
---

<article class:list={['card', { featured }]} id={id}>
  <div class="text">
  <h3>{solution.title}</h3>
  <p class="description">{solution.description}</p>
  {solution.features.length > 0 && (
    <ul class="features">
      {solution.features.map((feature) => <li>{feature}</li>)}
    </ul>
  )}
  </div>
  {solution.shot && (
    <figure class:list={['shot', solution.shot.file]}>
      <Image
        src={shots[solution.shot.file]}
        alt={solution.shot.alt}
        widths={[220, 440]}
        sizes="220px"
        loading="lazy"
      />
      <figcaption>{solution.shot.caption}</figcaption>
    </figure>
  )}
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
  }
  .description {
    color: var(--color-text-muted);
  }
  .features {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-1) 0 0;
    padding-left: 1.1em;
    color: var(--color-text);
  }
  .features li::marker {
    color: var(--color-text-muted);
  }
  .featured {
    padding: var(--space-8);
    border-top: 3px solid var(--color-action);
  }
  .featured h3 {
    font-size: var(--text-h2);
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex: 1;
  }
  .shot {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-1) 0 0;
  }
  .shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }
  .shot figcaption {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .featured {
    display: grid;
    grid-template-columns: 1fr var(--shot-width);
    gap: var(--space-8);
    align-items: center;
  }
  .featured .shot.painel-hoje :global(img) {
    border-radius: var(--radius-device-screen);
    border: var(--space-2) solid var(--dark-bg);
    box-shadow: var(--shadow-overlay);
  }
  @media (max-width: 760px) {
    .featured {
      grid-template-columns: 1fr;
    }
    .featured .shot.painel-hoje {
      max-width: var(--shot-width);
    }
  }
</style>
