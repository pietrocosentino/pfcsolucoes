---
import type { Solution } from '../data/site';

interface Props {
  solution: Solution;
}

const { solution } = Astro.props;
---

<article class="card">
  <p class="area">{solution.area}</p>
  <h3>{solution.title}</h3>
  <p class="description">{solution.description}</p>
  <ul class="features">
    {solution.features.map((feature) => <li>{feature}</li>)}
  </ul>
  <p class="project"><strong>Já desenvolvido:</strong> {solution.project}</p>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 26px;
    border-radius: var(--radius-md);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
  }
  .area {
    align-self: flex-start;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: var(--color-chip);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-ink);
  }
  .description {
    color: var(--color-muted);
  }
  .features {
    display: grid;
    gap: 8px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
  }
  .features li {
    position: relative;
    padding-left: 26px;
  }
  .features li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.45em;
    width: 12px;
    height: 7px;
    border-left: 2.5px solid var(--color-accent-text);
    border-bottom: 2.5px solid var(--color-accent-text);
    transform: rotate(-45deg);
  }
  .project {
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid var(--color-line);
    font-size: 0.875rem;
    color: var(--color-muted);
  }
  .project strong {
    color: var(--color-ink);
  }
</style>
