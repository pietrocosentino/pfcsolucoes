---
// Link com aparência de botão. Use `external` para links que abrem outra aba:
// o componente adiciona rel seguro e avisa leitores de tela. Com `chat`, o
// clique abre o atendente de IA (o href fica como alternativa sem JavaScript).
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'inverse' | 'inverse-outline';
  external?: boolean;
  chat?: boolean;
  class?: string;
}

const { href, variant = 'primary', external = false, chat = false, class: className } = Astro.props;
---

<a
  href={href}
  class:list={['btn', `btn--${variant}`, className]}
  {...external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
  {...chat ? { 'data-chat-open': '', 'aria-haspopup': 'dialog' } : {}}
>
  <slot />
  {external && !chat && <span class="visually-hidden"> (abre em nova aba)</span>}
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: var(--control-md); /* alvo de toque confortável */
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-pill);
    border: 2px solid transparent;
    font-weight: var(--weight-bold);
    font-size: var(--text-md);
    line-height: var(--leading-snug);
    text-decoration: none;
    transition: background-color var(--duration) ease, color var(--duration) ease, border-color var(--duration) ease;
  }
  .btn[aria-disabled='true'] {
    background: var(--color-disabled-bg);
    border-color: transparent;
    color: var(--color-disabled-text);
    pointer-events: none;
  }


  .btn--primary {
    background: var(--color-action);
    color: var(--color-on-action);
  }
  .btn--primary:hover {
    background: var(--color-action-hover);
  }

  .btn--secondary {
    border-color: var(--color-heading);
    color: var(--color-heading);
  }
  .btn--secondary:hover {
    background: var(--color-subtle);
  }

  .btn--inverse {
    background: var(--dark-action);
    color: var(--dark-bg);
  }
  .btn--inverse:hover {
    background: var(--dark-action-hover);
  }
  .btn--inverse-outline {
    border-color: var(--dark-text);
    color: var(--dark-text);
  }
  .btn--inverse-outline:hover {
    background: var(--overlay-on-dark);
  }
  .btn--inverse:focus-visible,
  .btn--inverse-outline:focus-visible {
    outline-color: var(--dark-focus);
  }
</style>
