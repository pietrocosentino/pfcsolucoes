---
import Section from './Section.astro';
import { process } from '../data/site';
---

<Section id="como-funciona" title={process.title} lead={process.lead}>
  <ol class="steps">
    {process.steps.map((step, index) => (
      <li class="card step">
        <p class="label-caps number" aria-hidden="true">Etapa {index + 1}</p>
        <h3>
          <span class="visually-hidden">Etapa {index + 1}: </span>{step.title}
        </h3>
        <p class="text">{step.text}</p>
      </li>
    ))}
  </ol>

</Section>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .step {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
  }
  .number {
    color: var(--color-text-muted);
  }
  h3 {
    display: grid;
    gap: var(--space-1);
  }
  .text {
    color: var(--color-text);
  }
  @media (max-width: 760px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
