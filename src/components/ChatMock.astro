---
import { chat } from '../data/site';
---

<figure class="chat">
  <figcaption class="visually-hidden">{chat.summary}</figcaption>
  <div class="chat-card" aria-hidden="true">
    <div class="chat-top">
      <span class="avatar">IA</span>
      <span class="who">
        <strong>{chat.title}</strong>
        <span><i class="dot"></i>{chat.status}</span>
      </span>
    </div>
    <div class="chat-body">
      <p class="time">{chat.time}</p>
      {chat.messages.map((m) => (
        <p class:list={['bubble', m.from === 'cliente' ? 'in' : 'out']}>
          {m.text}
          {m.tag && <span class="tag">{m.tag}</span>}
        </p>
      ))}
    </div>
  </div>
  <p class="chat-note" aria-hidden="true">{chat.note}</p>
</figure>

<style>
  .chat {
    margin: 0;
    width: 100%;
    max-width: 380px;
    justify-self: center;
  }
  .chat-card {
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    box-shadow: 0 24px 48px -24px rgb(27 42 74 / 0.35);
    overflow: hidden;
  }
  .chat-top {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 16px;
    background: var(--brand-navy);
    color: #ffffff;
  }
  .avatar {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #c8401d; /* coral escurecido: texto branco com 5:1 */
    font-weight: 800;
    font-size: 0.8125rem;
  }
  .who {
    display: grid;
    line-height: 1.25;
    font-size: 0.8125rem;
  }
  .who strong {
    font-size: 0.9375rem;
  }
  .dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 6px;
    border-radius: 50%;
    background: #6ee7a8;
  }
  .chat-body {
    display: grid;
    gap: 8px;
    padding: 16px;
    background: var(--color-chip);
  }
  .time {
    justify-self: center;
    font-size: 0.75rem;
    color: var(--color-muted);
  }
  .bubble {
    max-width: 85%;
    padding: 9px 12px;
    border-radius: 14px;
    font-size: 0.9375rem;
    line-height: 1.4;
    color: var(--color-ink);
  }
  .in {
    justify-self: start;
    background: var(--color-surface);
    border-bottom-left-radius: 4px;
  }
  .out {
    justify-self: end;
    background: var(--color-bubble-out);
    border-bottom-right-radius: 4px;
  }
  .tag {
    display: block;
    margin-top: 6px;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-accent-text);
  }
  .chat-note {
    margin-top: 10px;
    text-align: center;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
</style>
