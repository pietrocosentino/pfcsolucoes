---
import SiteLayout from '../layouts/SiteLayout.astro';
import Hero from '../components/Hero.astro';
import Solutions from '../components/Solutions.astro';
import Services from '../components/Services.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import Pricing from '../components/Pricing.astro';
import About from '../components/About.astro';
import Faq from '../components/Faq.astro';
import ContactCta from '../components/ContactCta.astro';
import { faqSchema } from '../lib/schema';
---

<!-- Ordem: prova antes da lista de serviços; como cobramos e prazos concretos; contato direto com quem atende. -->
<SiteLayout schema={[faqSchema]}>
  <Hero />
  <Solutions />
  <Services />
  <ProcessSteps />
  <Pricing />
  <About />
  <Faq />
  <ContactCta />
</SiteLayout>
