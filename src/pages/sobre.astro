---
import { Image } from 'astro:assets';
import { breadcrumbSchema } from '../lib/schema';
import photo from '../assets/pietro-cosentino.jpg';
import SiteLayout from '../layouts/SiteLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import { about, brand, contact } from '../data/site';
import { aboutPage } from '../data/institutional';

// A primeira frase leva à página inicial (texto âncora da palavra-chave principal).
const anchor = 'sistemas sob medida para autônomos e pequenas empresas';
const [leadBefore, leadAfter] = aboutPage.lead.split(anchor);
---

<SiteLayout
  schema={[breadcrumbSchema(aboutPage.title, '/sobre')]}
  title={`${brand.name}: quem somos e como trabalhamos`}
  description="Conheça o Pietro e a PFC Soluções: sistemas sob medida para pequenos negócios, com proposta clara antes de começar. Veja o que já construímos."
>
  <PageIntro eyebrow="Institucional" title={aboutPage.title}>
    <p class="lead">{leadBefore}<a href="/">{anchor}</a>{leadAfter}</p>
  </PageIntro>

  <Section id="historia" title={aboutPage.story.title}>
    <div class="prose">
      {aboutPage.story.paragraphs.map((text) => <p>{text}</p>)}
    </div>
  </Section>

  <Section id="proposito" tone="band" title={aboutPage.purpose.title}>
    <p class="prose purpose">{aboutPage.purpose.text}</p>
    <p class="prose how">{aboutPage.howWeWork}</p>
  </Section>

  <Section id="fundador" title={about.name}>
    <Image class="photo" src={photo} alt="Pietro Cosentino, fundador da PFC Soluções" widths={[160, 320]} sizes="160px" loading="lazy" />
    <div class="prose">
      <p>{about.bio}</p>
    </div>
    <div class="actions">
      <Button href={about.portfolio.href} variant="secondary" external>{about.portfolio.label}</Button>
      <Button href={about.linkedin} variant="secondary" external>LinkedIn</Button>
    </div>
  </Section>

  <Section id="projetos" tone="band" title={aboutPage.built.title}>
    <ul class="built">
      {aboutPage.built.items.map((item) => <li>{item}</li>)}
    </ul>
    <div class="actions">
      <Button href={contact.whatsapp} external chat>{contact.ctaLabel}</Button>
    </div>
  </Section>
</SiteLayout>

<style>
  .prose {
    display: grid;
    gap: 16px;
    max-width: 68ch;
    font-size: 1.0625rem;
  }
  .purpose {
    display: block;
    margin-bottom: 28px;
  }
  #fundador :global(.photo) {
    width: 160px;
    height: 160px;
    margin-bottom: 20px;
    border-radius: 50%;
    object-fit: cover;
  }
  .how {
    margin-top: 16px;
    font-weight: 600;
    color: var(--color-ink);
  }
  .built {
    display: grid;
    gap: 8px;
    margin: 0;
    padding-left: 1.1em;
    font-weight: 600;
    color: var(--color-ink);
  }
  .built li::marker {
    color: var(--color-muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
</style>
