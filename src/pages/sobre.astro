---
import { breadcrumbSchema } from '../lib/schema';
import SiteLayout from '../layouts/SiteLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import { about, brand, contact } from '../data/site';
import { aboutPage } from '../data/institutional';

// A primeira frase leva à página inicial (texto âncora da palavra-chave principal).
const anchor = 'sistemas sob medida para autônomos e pequenas empresas';
const [leadBefore, leadAfter] = aboutPage.lead.split(anchor);
---

<SiteLayout
  schema={[breadcrumbSchema(aboutPage.title, '/sobre')]}
  title={`${brand.name}: quem somos e como trabalhamos`}
  description="Conheça o Pietro e a PFC Soluções: sistemas sob medida para pequenos negócios, com proposta clara antes de começar. Veja o que já construímos."
>
  <PageIntro eyebrow="Institucional" title={aboutPage.title}>
    <p class="lead">{leadBefore}<a href="/">{anchor}</a>{leadAfter}</p>
  </PageIntro>

  <Section id="historia" title={aboutPage.story.title}>
    <div class="prose">
      {aboutPage.story.paragraphs.map((text) => <p>{text}</p>)}
    </div>
  </Section>

  <Section id="proposito" tone="band" title={aboutPage.purpose.title}>
    <p class="prose purpose">{aboutPage.purpose.text}</p>
    <p class="prose how">{aboutPage.howWeWork}</p>
  </Section>

  <Section id="fundador" title={about.name}>
    <div class="prose">
      <p>{about.bio}</p>
    </div>
    <h3 class="trajectory-title">{aboutPage.trajectory.title}</h3>
    <ol class="trajectory">
      {aboutPage.trajectory.items.map((item) => (
        <li>
          <span class="when">{item.when}</span>
          <span>{item.text}</span>
        </li>
      ))}
    </ol>
    <div class="actions">
      <Button href={about.linkedin} variant="secondary" external>Ver no LinkedIn</Button>
    </div>
  </Section>

  <Section id="empresa" title={aboutPage.company.title}>
    <dl class="company">
      {aboutPage.company.rows.map(([label, value]) => (
        <div>
          <dt>{label}</dt>
          <dd>{label === 'Contato' ? <a href={`mailto:${value}`}>{value}</a> : value}</dd>
        </div>
      ))}
    </dl>
  </Section>

  <Section id="projetos" tone="band" title={aboutPage.built.title}>
    <ul class="built">
      {aboutPage.built.items.map((item) => <li>{item}</li>)}
    </ul>
    <div class="actions">
      <Button href={contact.whatsapp} external chat>{contact.ctaLabel}</Button>
    </div>
  </Section>
</SiteLayout>

<style>
  .prose {
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure);
    font-size: var(--text-lg);
  }
  .purpose {
    display: block;
    margin-bottom: var(--space-8);
  }
  .how {
    margin-top: var(--space-4);
    font-weight: var(--weight-semibold);
    color: var(--color-heading);
  }
  .built {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding-left: 1.1em;
    font-weight: var(--weight-semibold);
    color: var(--color-heading);
  }
  .built li::marker {
    color: var(--color-text-muted);
  }
  .trajectory-title {
    margin-top: var(--space-8);
  }
  .trajectory {
    display: grid;
    max-width: var(--measure);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
  }
  .trajectory li {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }
  .when {
    font-weight: var(--weight-semibold);
    color: var(--color-heading);
  }
  @media (max-width: 560px) {
    .trajectory li {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
  .company {
    display: grid;
    max-width: var(--measure);
    margin: 0;
    border-top: 1px solid var(--color-border);
  }
  .company div {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }
  .company dt {
    font-weight: var(--weight-semibold);
    color: var(--color-heading);
  }
  .company dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
  @media (max-width: 560px) {
    .company div {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
  .actions {
    margin-top: var(--space-8);
  }
</style>
