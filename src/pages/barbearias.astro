---
// Página do nicho de entrada (barbearias, salões e quem vive de agenda).
// Conteúdo e valores em src/data/barbearias.ts.
import SiteLayout from '../layouts/SiteLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import { about, contact } from '../data/site';
import { demoUrl, nichoPage, oferta, reais } from '../data/barbearias';

const { piloto } = oferta;
---

<SiteLayout title={nichoPage.meta.title} description={nichoPage.meta.description}>
  <PageIntro eyebrow={nichoPage.intro.eyebrow} title={nichoPage.intro.title} lead={nichoPage.intro.lead}>
    <div class="actions">
      <Button href={demoUrl} external>{nichoPage.intro.demoCta}</Button>
      <Button href={contact.whatsapp} variant="secondary" external chat>{contact.ctaLabel}</Button>
    </div>
    <p class="note">{nichoPage.intro.demoNote}</p>
  </PageIntro>

  <Section id="perdas" eyebrow={nichoPage.perdas.eyebrow} title={nichoPage.perdas.title}>
    <ul class="cards">
      {nichoPage.perdas.items.map((item) => (
        <li>
          <strong>{item.titulo}</strong>
          <span>{item.texto}</span>
        </li>
      ))}
    </ul>
  </Section>

  <Section id="como-funciona-nicho" tone="band" eyebrow={nichoPage.passos.eyebrow} title={nichoPage.passos.title}>
    <ol class="steps">
      {nichoPage.passos.items.map((text) => <li>{text}</li>)}
    </ol>
  </Section>

  <Section id="incluso" eyebrow={nichoPage.incluso.eyebrow} title={nichoPage.incluso.title}>
    <ul class="checks">
      {oferta.inclui.map((item) => <li>{item}</li>)}
    </ul>
  </Section>

  <Section id="piloto" tone="band" eyebrow={nichoPage.piloto.eyebrow} title={nichoPage.piloto.title} lead={nichoPage.piloto.lead}>
    <div class="price">
      <div class="price-row">
        <span class="price-label">Implantação</span>
        <span class="price-value">{reais(piloto.implantacao)}</span>
        <span class="price-old">valor cheio {reais(piloto.implantacaoCheia)}</span>
      </div>
      <div class="price-row">
        <span class="price-label">Mensalidade</span>
        <span class="price-value">{reais(piloto.mensalidade)}/mês</span>
        <span class="price-old">travada por {piloto.mesesTravados} meses (valor cheio {reais(piloto.mensalidadeCheia)}/mês)</span>
      </div>
      <p class="price-terms">
        {piloto.vagas} vagas. Em troca do valor de fundador, você aceita {piloto.contrapartida}. Escopo, prazo e condições
        ficam escritos na proposta antes de você decidir.
      </p>
      <div class="actions">
        <Button href={contact.whatsapp} external chat>{nichoPage.piloto.cta}</Button>
      </div>
    </div>
  </Section>

  <Section id="quem-faz" eyebrow="Quem faz" title={about.name}>
    <p class="prose">{about.bio} São 5 projetos já desenvolvidos, entre eles uma agenda online para barbearia.</p>
  </Section>

  <Section id="duvidas-nicho" tone="band" eyebrow="Dúvidas" title="Perguntas de quem tem barbearia">
    <div class="faq">
      {nichoPage.faq.map((item) => (
        <details>
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </Section>
</SiteLayout>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }
  .note {
    color: var(--color-muted);
    font-size: 0.9375rem;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cards li {
    display: grid;
    align-content: start;
    gap: 6px;
    padding: 20px;
    border-radius: var(--radius-md);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
  }
  .cards strong {
    color: var(--color-ink);
  }
  .cards span {
    color: var(--color-muted);
  }
  .steps {
    display: grid;
    gap: 14px;
    max-width: 68ch;
    margin: 0;
    padding-left: 1.4em;
    font-size: 1.0625rem;
  }
  .checks {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 12px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .checks li {
    position: relative;
    padding-left: 28px;
    color: var(--color-ink);
  }
  .checks li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.45em;
    width: 12px;
    height: 7px;
    border-left: 2.5px solid var(--color-accent-text);
    border-bottom: 2.5px solid var(--color-accent-text);
    transform: rotate(-45deg);
  }
  .price {
    display: grid;
    gap: 16px;
    max-width: 640px;
    padding: 24px;
    border-radius: var(--radius-md);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
  }
  .price-row {
    display: grid;
    gap: 2px;
  }
  .price-label {
    font-weight: 700;
    color: var(--color-muted);
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .price-value {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 800;
    color: var(--color-ink);
    letter-spacing: -0.02em;
  }
  .price-old,
  .price-terms {
    color: var(--color-muted);
  }
  .prose {
    max-width: 68ch;
    font-size: 1.0625rem;
  }
  .faq {
    display: grid;
    gap: 10px;
    max-width: 760px;
  }
  details {
    border-radius: var(--radius-md);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 56px;
    padding: 14px 20px;
    cursor: pointer;
    list-style: none;
    font-weight: 700;
    color: var(--color-ink);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    flex: none;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--color-accent-text);
  }
  details[open] summary::after {
    content: '−';
  }
  details p {
    padding: 0 20px 18px;
    color: var(--color-muted);
  }
</style>
